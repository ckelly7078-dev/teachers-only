KB_DB=/srv/teachers-private/foundation.sqlite
KB_USERS=/srv/teachers-private/teacher-users.json
# Optional Chat Completions compatible endpoint. Use an approved HTTPS service.
KB_MODEL_URL=
KB_MODEL_NAME=
KB_MODEL_KEY=

# Optional Question Studio Responses API (server process only). Leave blank to disable.
# Configure a supported Structured Outputs model, e.g. gpt-6-luna, via KB_STUDIO_MODEL.
KB_STUDIO_MODEL=
# Supply through a secret manager or temporary environment variable; never commit a real key.
OPENAI_API_KEY=
